{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-doos.local/schema/page.schema.json",
  "title": "杜陵杜氏世譜 page parse result",
  "type": "object",
  "required": ["page", "entries"],
  "additionalProperties": true,
  "properties": {
    "page": { "$ref": "#/$defs/page" },
    "subjects": {
      "type": "array",
      "description": "페이지의 기준 인물. 기준 인물의 모든 정보를 여기에 넣고 entries[]에 중복하지 않는다. 보통 1명이다.",
      "items": { "$ref": "#/$defs/subject" }
    },
    "entries": {
      "type": "array",
      "description": "기준 인물을 제외한 페이지의 인물 항목. 기준 인물은 subjects[]에만 넣는다.",
      "items": { "$ref": "#/$defs/entry" }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw"],
        "additionalProperties": true,
        "properties": {
          "raw": { "type": "string" },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "index_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name_hanja"],
        "additionalProperties": true,
        "properties": {
          "name_hanja": { "type": "string" },
          "name_hangul": { "type": ["string", "null"] },
          "page_ref": { "$ref": "#/$defs/page_ref" },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw"],
        "additionalProperties": true,
        "properties": {
          "raw": { "type": "string" },
          "kind": { "enum": ["note", "address", "burial", "other"] },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "page_texts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw"],
        "additionalProperties": true,
        "properties": {
          "raw": { "type": "string" },
          "kind": { "enum": ["body", "heading", "colophon", "other"] },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "generation_chars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chars"],
        "additionalProperties": true,
        "properties": {
          "generation_no": { "type": ["integer", "null"] },
          "position": { "enum": ["앞", "가운데", "뒤", null] },
          "chars": { "type": "array", "items": { "type": "string" } },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rows"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": ["string", "null"] },
          "headers": { "type": "array", "items": { "type": "string" } },
          "rows": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" } }
          },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "unreadable_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bbox", "reason"],
        "additionalProperties": true,
        "properties": {
          "bbox": { "$ref": "#/$defs/bbox" },
          "reason": { "enum": ["blur", "bleed_through", "cut_off", "unknown_char", "other"] }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1000 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "certainty": { "enum": ["exact", "probable", "uncertain", "unknown"] },
    "page": {
      "type": "object",
      "required": ["section", "printed_page_no", "page_type"],
      "additionalProperties": true,
      "properties": {
        "section": {
          "description": "frontmatter=전편, genealogy=본편.",
          "enum": ["frontmatter", "genealogy"]
        },
        "printed_page_no": { "type": "integer", "minimum": 1 },
        "page_type": {
          "description": "페이지 유형. genealogy가 아니면 entries를 비우고 해당 보조 필드를 쓴다.",
          "enum": [
            "genealogy",
            "preface",
            "photo",
            "index",
            "generation_name_table",
            "property",
            "officers",
            "subscription",
            "colophon",
            "cover",
            "unknown"
          ]
        },
        "quality": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "rotation_degrees": { "type": ["number", "null"] },
            "blur": { "enum": ["low", "medium", "high", null] },
            "bleed_through": { "enum": ["low", "medium", "high", null] },
            "needs_human": { "type": "boolean" }
          }
        },
        "header": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "running_head": { "type": ["string", "null"] },
            "father_name": { "type": ["string", "null"] },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "page_ref": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["raw", "direction", "target_section", "target_page_no"],
          "additionalProperties": true,
          "properties": {
            "raw": {
              "description": "인쇄된 참조 원문. 예: 上159, 見上十三, 下4. 스캔에서 T/F로 보여도 下###로 정규화한다.",
              "type": "string"
            },
            "direction": {
              "description": "up=上(조상/부모), down=下(자손).",
              "enum": ["up", "down"]
            },
            "target_section": {
              "description": "본편이면 genealogy, 전편이면 frontmatter. 항상 채운다.",
              "enum": ["frontmatter", "genealogy"]
            },
            "target_page_no": { "type": "integer", "minimum": 1 },
            "bbox": { "$ref": "#/$defs/bbox" },
            "confidence": { "$ref": "#/$defs/confidence" }
          }
        }
      ]
    },
    "alias": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": true,
      "properties": {
        "type": { "enum": ["字", "號", "其他"] },
        "value": { "type": "string" }
      }
    },
    "date_block": {
      "type": ["object", "null"],
      "required": ["raw"],
      "additionalProperties": true,
      "properties": {
        "raw": { "type": ["string", "null"] },
        "king_era": { "type": ["string", "null"] },
        "ganji": { "type": ["string", "null"] },
        "date_text": { "type": ["string", "null"] },
        "certainty": { "$ref": "#/$defs/certainty" }
      }
    },
    "burial": {
      "type": ["object", "null"],
      "required": ["raw"],
      "additionalProperties": true,
      "properties": {
        "raw": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "orientation": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "certainty": { "$ref": "#/$defs/certainty" }
      }
    },
    "spouse": {
      "type": "object",
      "required": ["as_printed"],
      "additionalProperties": true,
      "properties": {
        "as_printed": { "type": "string" },
        "name_hanja": { "type": ["string", "null"] },
        "bonkwan": { "type": ["string", "null"] },
        "father": { "type": ["string", "null"] },
        "relation": {
          "description": "이 인물과 배우자의 관계. 남자 인물의 배우자는 wife, 여자 인물의 배우자는 husband. 女 뒤 성씨+이름으로 인쇄된 사위도 husband다.",
          "enum": ["wife", "husband", "concubine", "unknown"]
        },
        "birth": { "$ref": "#/$defs/date_block" },
        "death": { "$ref": "#/$defs/date_block" },
        "burial": { "$ref": "#/$defs/burial" },
        "certainty": { "$ref": "#/$defs/certainty" }
      }
    },
    "child": {
      "type": "object",
      "required": ["as_printed"],
      "additionalProperties": true,
      "properties": {
        "as_printed": { "type": "string" },
        "name_hanja": { "type": ["string", "null"] },
        "prefix": { "type": ["string", "null"] },
        "relation": {
          "description": "그 인물 항목 안에 함께 인쇄된 자녀의 관계.",
          "enum": ["son", "daughter", "adopted_son", "unknown"]
        },
        "page_ref": { "$ref": "#/$defs/page_ref" }
      }
    },
    "father_ref": {
      "description": "아버지 연결. 같은 페이지에 아버지가 있으면 row/column으로 가리키고, 다른 페이지면 page_ref(上###)를 쓴다. 모르면 null이고 needs_human=true로 둔다. DB 적재 시 people.father_id로 변환한다.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["as_printed"],
          "additionalProperties": true,
          "properties": {
            "as_printed": {
              "description": "아버지 이름(인쇄된 그대로).",
              "type": "string"
            },
            "name_hanja": { "type": ["string", "null"] },
            "row": {
              "description": "같은 페이지에 아버지가 있으면 그 단 번호.",
              "type": ["integer", "null"]
            },
            "column": {
              "description": "같은 페이지에 아버지가 있으면 그 열 번호.",
              "type": ["integer", "null"]
            },
            "page_ref": { "$ref": "#/$defs/page_ref" },
            "relation": {
              "description": "아버지 관계. 양자로 표시된 경우 adoptive_father.",
              "enum": ["father", "adoptive_father", "unknown"]
            },
            "confidence": { "$ref": "#/$defs/confidence" },
            "needs_human": { "type": "boolean" }
          }
        }
      ]
    },
    "person": {
      "type": "object",
      "required": ["as_printed"],
      "additionalProperties": true,
      "properties": {
        "as_printed": { "type": "string" },
        "name_hanja": { "type": ["string", "null"] },
        "name_hangul": { "type": ["string", "null"] },
        "prefix": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
        "generation_no": { "type": ["integer", "null"] },
        "generation_hint": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "value": { "type": "integer" },
            "basis": { "type": "string" },
            "certainty": { "enum": ["probable", "uncertain"] }
          }
        },
        "generation_char": { "type": ["string", "null"] },
        "birth": { "$ref": "#/$defs/date_block" },
        "death": { "$ref": "#/$defs/date_block" },
        "burial": { "$ref": "#/$defs/burial" },
        "offices": { "type": "array", "items": { "type": "string" } },
        "father": {
          "description": "아버지 연결. 계보의 정본은 이 연결이며, relation_to_subject는 페이지 안의 참고값이다.",
          "$ref": "#/$defs/father_ref"
        },
        "spouses": { "type": "array", "items": { "$ref": "#/$defs/spouse" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/child" } },
        "page_ref": { "$ref": "#/$defs/page_ref" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "needs_human": { "type": "boolean" },
        "notes": {
          "description": "그 인물에 붙은 설명·부기. 한 줄에 하나.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "placement": {
      "type": "object",
      "required": ["row", "column"],
      "additionalProperties": true,
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "generation_offset": {
          "description": "기준 인물 기준 상대 세대. subjects[]에서는 0.",
          "type": "integer",
          "minimum": 0
        },
        "relation_to_subject": {
          "description": "기준 인물과의 페이지 안 관계. 계보의 정본이 아니라 검수용 힌트다. 세대는 person.father 연결로 계산한다. subjects[]에서는 self.",
          "enum": [
            "self",
            "son",
            "daughter",
            "brother",
            "sister",
            "sibling",
            "grandson",
            "granddaughter",
            "descendant",
            "spouse",
            "son_in_law",
            "daughter_in_law",
            "unknown"
          ]
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "needs_human": { "type": "boolean" }
      }
    },
    "subject": {
      "description": "페이지의 기준 인물. row/column은 인쇄된 위치, generation_offset은 0, relation_to_subject는 self다. 기준 인물의 생몰·묘소·배우자·자녀 등 모든 정보를 여기에 넣는다.",
      "allOf": [
        { "$ref": "#/$defs/placement" },
        { "$ref": "#/$defs/person" }
      ]
    },
    "entry": {
      "description": "기준 인물을 제외한 인물 항목. 기준 인물을 다시 넣지 않으므로 relation_to_subject에 self를 쓰지 않는다.",
      "type": "object",
      "required": ["row", "column", "relation_to_subject", "person"],
      "additionalProperties": true,
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "generation_offset": { "type": "integer", "minimum": 0 },
        "relation_to_subject": {
          "enum": [
            "son",
            "daughter",
            "brother",
            "sister",
            "sibling",
            "grandson",
            "granddaughter",
            "descendant",
            "spouse",
            "son_in_law",
            "daughter_in_law",
            "unknown"
          ]
        },
        "person": { "$ref": "#/$defs/person" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "needs_human": { "type": "boolean" }
      }
    }
  }
}
