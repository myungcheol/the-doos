{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-doos.local/schema/page.schema.json",
  "title": "杜陵杜氏世譜 page parse result",
  "type": "object",
  "required": ["page", "entries"],
  "additionalProperties": true,
  "properties": {
    "page": { "$ref": "#/$defs/page" },
    "subjects": {
      "type": "array",
      "items": { "$ref": "#/$defs/subject" }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw"],
        "additionalProperties": true,
        "properties": {
          "raw": { "type": "string" },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "index_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name_hanja"],
        "additionalProperties": true,
        "properties": {
          "name_hanja": { "type": "string" },
          "name_hangul": { "type": ["string", "null"] },
          "page_ref": { "$ref": "#/$defs/page_ref" },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw"],
        "additionalProperties": true,
        "properties": {
          "raw": { "type": "string" },
          "kind": { "enum": ["note", "address", "burial", "other"] },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "page_texts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["raw"],
        "additionalProperties": true,
        "properties": {
          "raw": { "type": "string" },
          "kind": { "enum": ["body", "heading", "colophon", "other"] },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "generation_chars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chars"],
        "additionalProperties": true,
        "properties": {
          "generation_no": { "type": ["integer", "null"] },
          "position": { "enum": ["앞", "가운데", "뒤", null] },
          "chars": { "type": "array", "items": { "type": "string" } },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rows"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": ["string", "null"] },
          "headers": { "type": "array", "items": { "type": "string" } },
          "rows": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" } }
          },
          "bbox": { "$ref": "#/$defs/bbox" }
        }
      }
    },
    "unreadable_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bbox", "reason"],
        "additionalProperties": true,
        "properties": {
          "bbox": { "$ref": "#/$defs/bbox" },
          "reason": { "enum": ["blur", "bleed_through", "cut_off", "unknown_char", "other"] }
        }
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1000 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "certainty": { "enum": ["exact", "probable", "uncertain", "unknown"] },
    "page": {
      "type": "object",
      "required": ["section", "printed_page_no", "page_type"],
      "additionalProperties": true,
      "properties": {
        "section": { "enum": ["frontmatter", "genealogy"] },
        "printed_page_no": { "type": "integer", "minimum": 1 },
        "page_type": {
          "enum": [
            "genealogy",
            "preface",
            "photo",
            "index",
            "generation_name_table",
            "property",
            "officers",
            "subscription",
            "colophon",
            "cover",
            "unknown"
          ]
        },
        "quality": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rotation_degrees": { "type": ["number", "null"] },
            "blur": { "enum": ["low", "medium", "high", null] },
            "bleed_through": { "enum": ["low", "medium", "high", null] },
            "needs_human": { "type": "boolean" }
          }
        },
        "header": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "running_head": { "type": ["string", "null"] },
            "father_name": { "type": ["string", "null"] },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "page_ref": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["raw", "direction", "target_section", "target_page_no"],
          "additionalProperties": true,
          "properties": {
            "raw": { "type": "string" },
            "direction": { "enum": ["up", "down"] },
            "target_section": { "enum": ["frontmatter", "genealogy"] },
            "target_page_no": { "type": "integer", "minimum": 1 },
            "bbox": { "$ref": "#/$defs/bbox" },
            "confidence": { "$ref": "#/$defs/confidence" }
          }
        }
      ]
    },
    "alias": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": true,
      "properties": {
        "type": { "enum": ["字", "號", "其他"] },
        "value": { "type": "string" }
      }
    },
    "date_block": {
      "type": "object",
      "required": ["raw"],
      "additionalProperties": true,
      "properties": {
        "raw": { "type": ["string", "null"] },
        "king_era": { "type": ["string", "null"] },
        "ganji": { "type": ["string", "null"] },
        "date_text": { "type": ["string", "null"] },
        "certainty": { "$ref": "#/$defs/certainty" }
      }
    },
    "burial": {
      "type": "object",
      "required": ["raw"],
      "additionalProperties": true,
      "properties": {
        "raw": { "type": ["string", "null"] },
        "location": { "type": ["string", "null"] },
        "orientation": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "certainty": { "$ref": "#/$defs/certainty" }
      }
    },
    "spouse": {
      "type": "object",
      "required": ["raw_name"],
      "additionalProperties": true,
      "properties": {
        "raw_name": { "type": "string" },
        "name_hanja": { "type": ["string", "null"] },
        "bonkwan": { "type": ["string", "null"] },
        "father": { "type": ["string", "null"] },
        "relation": { "enum": ["wife", "husband", "son_in_law", "daughter_in_law", "unknown"] },
        "burial": { "$ref": "#/$defs/burial" },
        "certainty": { "$ref": "#/$defs/certainty" }
      }
    },
    "child": {
      "type": "object",
      "required": ["raw_name"],
      "additionalProperties": true,
      "properties": {
        "raw_name": { "type": "string" },
        "name_hanja": { "type": ["string", "null"] },
        "prefix": { "type": ["string", "null"] },
        "relation": { "enum": ["son", "daughter", "adopted_son", "unknown"] },
        "page_ref": { "$ref": "#/$defs/page_ref" }
      }
    },
    "person": {
      "type": "object",
      "required": ["raw_name"],
      "additionalProperties": true,
      "properties": {
        "raw_name": { "type": "string" },
        "name_hanja": { "type": ["string", "null"] },
        "name_hangul": { "type": ["string", "null"] },
        "prefix": { "type": ["string", "null"] },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
        "generation_no": { "type": ["integer", "null"] },
        "generation_hint": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "value": { "type": "integer" },
            "basis": { "type": "string" },
            "certainty": { "enum": ["probable", "uncertain"] }
          }
        },
        "generation_char": { "type": ["string", "null"] },
        "birth": { "$ref": "#/$defs/date_block" },
        "death": { "$ref": "#/$defs/date_block" },
        "burial": { "$ref": "#/$defs/burial" },
        "offices": { "type": "array", "items": { "type": "string" } },
        "spouses": { "type": "array", "items": { "$ref": "#/$defs/spouse" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/child" } },
        "page_ref": { "$ref": "#/$defs/page_ref" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "needs_human": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "placement": {
      "type": "object",
      "required": ["row", "column"],
      "additionalProperties": true,
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "generation_offset": { "type": "integer", "minimum": 0 },
        "relation_to_subject": {
          "enum": [
            "self",
            "son",
            "daughter",
            "brother",
            "sister",
            "sibling",
            "grandson",
            "granddaughter",
            "descendant",
            "spouse",
            "son_in_law",
            "daughter_in_law",
            "unknown"
          ]
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "needs_human": { "type": "boolean" }
      }
    },
    "subject": {
      "allOf": [
        { "$ref": "#/$defs/placement" },
        { "$ref": "#/$defs/person" }
      ]
    },
    "entry": {
      "type": "object",
      "required": ["row", "column", "person"],
      "additionalProperties": true,
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "generation_offset": { "type": "integer", "minimum": 0 },
        "relation_to_subject": {
          "enum": [
            "self",
            "son",
            "daughter",
            "brother",
            "sister",
            "sibling",
            "grandson",
            "granddaughter",
            "descendant",
            "spouse",
            "son_in_law",
            "daughter_in_law",
            "unknown"
          ]
        },
        "person": { "$ref": "#/$defs/person" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "needs_human": { "type": "boolean" }
      }
    }
  }
}
