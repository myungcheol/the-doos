{
  "name": "jokbo-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/prepare-font.mjs",
    "dev": "next dev --hostname 0.0.0.0",
