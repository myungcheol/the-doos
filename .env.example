# 복사해서 .env로 저장한 뒤 값을 채우세요.
# .env는 git에 올라가지 않습니다. 셸 환경변수가 있으면 그 값이 우선합니다.

# OmniRoute 예시
PAGE_AI_BASE_URL=http://localhost:20128/v1
PAGE_AI_API_KEY=
PAGE_AI_MODEL=
PAGE_AI_TIMEOUT=600
PAGE_AI_MAX_TOKENS=32768
PAGE_AI_REASONING_EFFORT=low
# Gemini 계열은 OmniRoute에서 thinking 비활성화가 무시될 수 있다. 필요할 때만 켠다.
# PAGE_AI_EXTRA_BODY={"thinking":{"type":"disabled"}}
PAGE_AI_EXTRA_HEADERS={"x-omniroute-compression":"off","X-OmniRoute-No-Cache":"true","x-omniroute-no-memory":"true","x-omniroute-disabled-guardrails":"vision-bridge,visionBridge"}

# Google AI Studio 예시
# PAGE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PAGE_AI_API_KEY=
# PAGE_AI_MODEL=gemini-2.5-flash
# PAGE_AI_TIMEOUT=180

# OpenRouter 예시
# PAGE_AI_BASE_URL=https://openrouter.ai/api/v1
# PAGE_AI_API_KEY=
# PAGE_AI_MODEL=

# JSON 모드는 combo의 모든 모델이 지원할 때만 1
# PAGE_AI_JSON_MODE=1

# ---------------------------------------------------------------------------
# PostgreSQL / 로컬 Docker Compose (compose.yaml)
# ---------------------------------------------------------------------------
# 기본값은 로컬 테스트 전용이다. 실제 배포에는 다른 값을 쓴다.
POSTGRES_DB=jokbo
POSTGRES_USER=jokbo
# 로컬 전용 값도 직접 정하고, 실제 서비스 비밀번호를 저장소에 커밋하지 않는다.
POSTGRES_PASSWORD=change-me
# 호스트 포트. 5432가 이미 쓰이면 5433 등으로 바꾼다.
POSTGRES_PORT=5432
# Python 프로그램은 이 URL을 읽는다. 위 사용자·비밀번호·포트를 바꾸면 함께 바꾼다.
DATABASE_URL=postgresql://jokbo:change-me@127.0.0.1:5432/jokbo
# 원본 스캔과 ROI의 내용 주소 저장소. 상대 경로는 저장소 루트 기준이다.
JOKBO_ASSET_ROOT=./jokbo-assets

# Next.js 열람실: npm 실행은 위 DATABASE_URL을 사용한다.
# Docker에서는 로컬 DB 서비스 이름 postgres로 연결하거나 외부 DB URL을 지정한다.
# 실제 서비스에서는 읽기 전용 DB 사용자의 URL을 권장한다.
# JOKBO_WEB_DATABASE_URL=postgresql://jokbo:change-me@postgres:5432/jokbo
# 공개할 판본 ID를 쉼표로 구분한다. 비어 있으면 모든 판본을 열람한다.
JOKBO_PUBLIC_EDITIONS=jokbo-1987
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
