# 복사해서 .env로 저장한 뒤 값을 채우세요.
# .env는 git에 올라가지 않습니다. 셸 환경변수가 있으면 그 값이 우선합니다.

# OmniRoute 예시
PAGE_AI_BASE_URL=http://localhost:20128/v1
PAGE_AI_API_KEY=
PAGE_AI_MODEL=
PAGE_AI_TIMEOUT=600
PAGE_AI_MAX_TOKENS=32768
PAGE_AI_REASONING_EFFORT=low
# Gemini 계열은 OmniRoute에서 thinking 비활성화가 무시될 수 있다. 필요할 때만 켠다.
# PAGE_AI_EXTRA_BODY={"thinking":{"type":"disabled"}}
PAGE_AI_EXTRA_HEADERS={"x-omniroute-compression":"off","X-OmniRoute-No-Cache":"true","x-omniroute-no-memory":"true","x-omniroute-disabled-guardrails":"vision-bridge,visionBridge"}

# Google AI Studio 예시
# PAGE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PAGE_AI_API_KEY=
# PAGE_AI_MODEL=gemini-2.5-flash
# PAGE_AI_TIMEOUT=180

# OpenRouter 예시
# PAGE_AI_BASE_URL=https://openrouter.ai/api/v1
# PAGE_AI_API_KEY=
# PAGE_AI_MODEL=

# JSON 모드는 combo의 모든 모델이 지원할 때만 1
# PAGE_AI_JSON_MODE=1

# ---------------------------------------------------------------------------
# PostgreSQL / Docker 테스트 스택 (docker-compose.yaml)
# ---------------------------------------------------------------------------
# 기본값은 로컬 테스트 전용이다. 실제 배포에는 다른 값을 쓴다.
POSTGRES_DB=doos
POSTGRES_USER=doos
POSTGRES_PASSWORD=doos
# 호스트 포트. 5432가 이미 쓰이면 5433 등으로 바꾼다.
POSTGRES_PORT=5432
ADMIN_PORT=8765
# 공개 웹앱 포트
PUBLIC_PORT=8080
# 도구 컨테이너가 저장소에 만드는 파일의 소유자. `id -u`, `id -g` 값과 맞춘다.
LOCAL_UID=1000
LOCAL_GID=1000

# 호스트에서 직접 붙을 때
# DATABASE_URL=postgresql://doos:doos@127.0.0.1:5432/doos
